# ═══════════════════════════════════════════════════════════════
#  Nova Web Prospector — variables d'environnement
#  Copier ce fichier en .env.local puis renseigner les valeurs.
#  Toutes les clés restent côté serveur (jamais exposées au navigateur).
# ═══════════════════════════════════════════════════════════════

# ─── Base de données ───────────────────────────────────────────
# Vide = PostgreSQL embarqué (PGlite) stocké dans PGLITE_DATA_DIR : idéal en local.
# Production (Vercel…) : URL PostgreSQL obligatoire (Supabase, Neon…).
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# ─── Authentification (OBLIGATOIRE) ────────────────────────────
# Chaîne aléatoire de 32 caractères minimum (signature des sessions).
AUTH_SECRET=WrT8h3MwG2p6Q1jBJDQjRS8CiNNAVZxwhJkl1-buxmb4Slw4zwPT4MIwtft8uyGV

# ─── Recherche d'entreprises ───────────────────────────────────
# Google Places API (New) — source recommandée (notes, avis, téléphone, site, fiche Maps).
# Google Cloud Console → activer « Places API (New) » → clé restreinte à cette API.
GOOGLE_MAPS_API_KEY=

# OpenStreetMap — gratuit, sans clé, utilisé si GOOGLE_MAPS_API_KEY est vide.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
# Email de contact transmis à OSM (politique d'usage de Nominatim).
OSM_CONTACT_EMAIL=

# ─── Analyse des sites ─────────────────────────────────────────
# PageSpeed Insights (scores Lighthouse mobile + capture d'écran du site).
# Peut être la même clé que GOOGLE_MAPS_API_KEY si l'API « PageSpeed Insights » est activée.
GOOGLE_PAGESPEED_API_KEY=

# ─── IA : messages personnalisés, Nova AI, revue visuelle ──────
# Sans clé : moteur de règles (personnalisé, clairement étiqueté).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Recherche web (sites non référencés, réseaux sociaux) — optionnel ─
# Renseigner l'une des deux.
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# ─── Instagram Graph API, Business Discovery — optionnel ───────
# Permet de vérifier l'activité d'un compte Instagram professionnel.
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─── Envoi d'emails via votre boîte (SMTP) — optionnel ─────────
# Envoi unitaire, toujours après validation manuelle, avec plafond journalier.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_DAILY_LIMIT=30

# Compte de test créé pendant la recette locale (à supprimer ou changer depuis Paramètres > Mon compte)
DEV_TEST_ADMIN_EMAIL=recette@novaweb.test
DEV_TEST_ADMIN_PASSWORD=Recette27m7jAq4bxjX7
